generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String?
  email         String         @unique
  password      String
  role          Role           @default(VOLUNTEER)
  ministryId    Int?
  updatedAt     DateTime       @updatedAt
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  ministry      Ministry?      @relation(fields: [ministryId], references: [id])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Volunteer {
  id                     Int                        @id @default(autoincrement())
  address                String?
  civilStatus            String
  createdAt              DateTime                   @default(now())
  dateOfBirth            DateTime?
  email                  String?                    @unique
  firstName              String
  lastName               String
  middleInitial          String?
  nickname               String?
  occupation             String?
  phone                  String?
  profilePicture         String?
  sex                    String
  status                 String                     @default("ACTIVE")
  volunteerCode          String                     @unique
  sacraments             SacramentName[]
  applicationStatus      ApplicationStatus          @default(PENDING)
  joinedYearShrine       Int?
  ministryId             Int?
  classification         VolunteerClassification?   @default(REGULAR)
  joinedYearMinistry     Int?
  eventAttendance        EventAttendance[]
  eventLinks             EventVolunteer[]
  Ministry               Ministry?                  @relation(fields: [ministryId], references: [id], map: "volunteer_ministry_fk")
  attendances            VolunteerAttendance[]
  formations             VolunteerFormation[]
  ministryHistories      VolunteerMinistryHistory[]
  VolunteerServiceRecord VolunteerServiceRecord[]
  timelines              VolunteerTimeline[]
}

model VolunteerMinistryHistory {
  id          Int       @id @default(autoincrement())
  volunteerId Int
  ministryId  Int
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  status      String    @default("ACTIVE")
  ministry    Ministry  @relation(fields: [ministryId], references: [id])
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([volunteerId])
}

model Ministry {
  id            Int                        @id @default(autoincrement())
  name          String                     @unique
  icon          String                     @default("Church")
  type          MinistryType?
  parentId      Int?
  ministryCode  String?                    @unique @db.VarChar(5)
  Criteria      Criteria[]
  Event         Event[]
  parent        Ministry?                  @relation("MinistryHierarchy", fields: [parentId], references: [id], onUpdate: NoAction, map: "ministry_parent_fk")
  subMinistries Ministry[]                 @relation("MinistryHierarchy")
  ServicePillar ServicePillar[]
  users         User[]
  Volunteer     Volunteer[]
  attendance    VolunteerAttendance[]
  volunteers    VolunteerMinistryHistory[]
}

model VolunteerAttendance {
  id            Int            @id @default(autoincrement())
  remarks       String?
  absences      Int?           @default(0)
  meetings      Int?           @default(0)
  ministryId    Int
  volunteerId   Int
  month         Int
  present       Boolean
  type          AttendanceType
  week          Int?
  year          Int
  day           Int?
  monthlyServed Int?           @default(0)
  totalServe    Int?           @default(0)
  presentCount  Int?           @default(0)
  timeIn        DateTime?      @db.Timestamp(6)
  timeOut       DateTime?      @db.Timestamp(6)
  serviceOrder  Int?           @default(1)
  ministry      Ministry       @relation(fields: [ministryId], references: [id])
  volunteer     Volunteer      @relation(fields: [volunteerId], references: [id])

  @@unique([volunteerId, type, week, month, year, day], map: "VolunteerAttendance_volunteerId_type_week_month_year_key")
  @@unique([volunteerId, type, month, year, day, serviceOrder], map: "VolunteerAttendance_unique_service")
  @@index([volunteerId, day, month, year, serviceOrder], map: "idx_attendance_day_order")
}

model VolunteerAttendanceSummary {
  id             Int                 @id @default(autoincrement())
  volunteerId    Int
  month          Int
  year           Int
  monthlyServed  Int                 @default(0)
  totalServe     Int                 @default(0)
  served         Json?
  remarks        String?
  monthlyMeeting meeting_attendance? @default(ABSENT)

  @@unique([volunteerId, month, year], name: "volunteer_summary_unique", map: "volunteer_summary_unique")
}

model Event {
  id          Int               @id @default(autoincrement())
  description String?
  startDate   DateTime
  endDate     DateTime
  startTime   String
  endTime     String
  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  title       String
  status      EventStatus       @default(UPCOMING)
  ministryId  Int?
  Ministry    Ministry?         @relation(fields: [ministryId], references: [id], onUpdate: NoAction)
  attendance  EventAttendance[]
  volunteers  EventVolunteer[]
}

model EventVolunteer {
  id          Int       @id @default(autoincrement())
  eventId     Int
  volunteerId Int
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id])
}

model EventAttendance {
  id          Int                  @id @default(autoincrement())
  eventId     Int
  volunteerId Int
  status      AttendanceStatus     @default(PENDING)
  session     event_session?
  response    attendance_response? @default(NO_RESPONSE)
  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  volunteer   Volunteer            @relation(fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventId, volunteerId])
  @@unique([eventId, volunteerId, session], map: "event_volunteer_session_unique")
}

model VolunteerFormation {
  id          Int       @id @default(autoincrement())
  volunteerId Int
  name        String
  year        Int
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([volunteerId])
}

model VolunteerTimeline {
  id           Int       @id @default(autoincrement())
  volunteerId  Int
  organization String
  startYear    Int
  endYear      Int?
  totalYears   Int
  type         String
  parish       String?
  volunteer    Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([volunteerId])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresat DateTime @db.Timestamp(6)
  createdat DateTime @default(now()) @db.Timestamp(6)
}

model VolunteerServiceRecord {
  id            Int                 @id @default(autoincrement())
  volunteerId   Int
  yearStarted   Int?
  year          Int
  commitment    Int?                @default(0)
  attended      Int?                @default(0)
  absent        Int?                @default(0)
  meetingStatus meeting_attendance? @default(PRESENT)
  remarks       service_remarks?    @default(REGULAR)
  memberStatus  member_status?      @default(INACTIVE)
  createdAt     DateTime?           @default(now()) @db.Timestamp(6)
  updatedAt     DateTime?           @default(now()) @db.Timestamp(6)
  Volunteer     Volunteer           @relation(fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_volunteer")

  @@unique([volunteerId, year], map: "volunteer_year_unique")
}

model VolunteerCodeSequence {
  groupKey  String   @id
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model VolunteerServiceSession {
  id          Int       @id @default(autoincrement())
  volunteerId Int
  ministryId  Int
  day         Int
  month       Int
  year        Int
  timeIn      DateTime? @db.Timestamp(6)
  timeOut     DateTime? @db.Timestamp(6)
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @db.Timestamp(6)
  role        String?
}

model Criteria {
  id         Int          @id @default(autoincrement())
  pillarId   Int
  ministryId Int?
  title      String
  type       CriteriaType
  weight     Decimal      @db.Decimal
  Ministry   Ministry?    @relation(fields: [ministryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Pillar     Pillar       @relation(fields: [pillarId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Pillar {
  id        Int        @id @default(autoincrement())
  title     String
  createdAt DateTime?  @default(now()) @db.Timestamp(6)
  Criteria  Criteria[]
}

model ServicePillar {
  id         Int       @id @default(autoincrement())
  ministryId Int
  title      String
  points     Int?      @default(1)
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @db.Timestamp(6)
  Ministry   Ministry  @relation(fields: [ministryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ministry")
}

enum Role {
  CHAIRMAN
  ADMIN
  VOLUNTEER
  STAFF
}

enum SacramentName {
  BAPTISM
  CONFIRMATION
  EUCHARIST
  RECONCILIATION
  ANOINTING_OF_THE_SICK
  HOLY_ORDERS
  MATRIMONY
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  ABSENT
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum MinistryType {
  LITURGICAL
  PASTORAL
}

enum AttendanceType {
  DAILY
  MONTHLY_MEETING
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum attendance_response {
  ON_LEAVE
  EXCUSE
  CAN_ATTEND
  CANT_ATTEND
  NO_RESPONSE
}

enum event_session {
  AM
  PM
}

enum VolunteerClassification {
  REGULAR
  SEASONAL
  EMERITUS
}

enum meeting_attendance {
  PRESENT
  ABSENT
  EXCUSED
}

enum member_status {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum service_remarks {
  REGULAR
  SEASONAL
  ON_LEAVE
}

enum CriteriaType {
  MEETING
  SERVICE
}
