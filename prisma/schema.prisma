generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  
}

/**
 * ─── ENUMS ───────────────────────────────────
 */
enum Role {
  ADMIN
  CHAIRMAN
  STAFF
  VOLUNTEER
}

enum SacramentName {
  BAPTISM
  CONFIRMATION
  EUCHARIST
  RECONCILIATION
  ANOINTING_OF_THE_SICK
  HOLY_ORDERS
  MATRIMONY
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  ABSENT
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum MinistryType {
  LITURGICAL
  PASTORAL
}

/**
 * ─── USERS ────────────────────────────────────
 */
model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String  @unique
  password String
  role     Role    @default(VOLUNTEER)

  ministryId Int?
  ministry   Ministry? @relation(fields: [ministryId], references: [id])

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ─── AUTH ─────────────────────────────────────
 */
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ─── VOLUNTEERS ──────────────────────────────
 */
model Volunteer {
  id                Int                        @id @default(autoincrement())
  volunteerCode     String                     @unique
  firstName         String
  lastName          String
  middleInitial     String?
  nickname          String?
  email             String                     @unique
  phone             String?
  address           String?
  dateOfBirth       DateTime?
  sex               String
  civilStatus       String
  occupation        String?
 status String @default("ACTIVE")

  profilePicture    String?
  applicationStatus ApplicationStatus          @default(PENDING)
  createdAt         DateTime                   @default(now())
  eventLinks        EventVolunteer[]
  eventAttendance   EventAttendance[]
  attendances       VolunteerAttendance[]
  sacraments        SacramentName[]
  ministryHistories VolunteerMinistryHistory[]
  massBookings      MassBooking[]
  formations        VolunteerFormation[]
  timelines         VolunteerTimeline[]
}

/**
 * ─── VOLUNTEER MINISTRY HISTORY ─────────────
 */
model VolunteerMinistryHistory {
  id          Int       @id @default(autoincrement())
  volunteerId Int
  ministryId  Int
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  status      String    @default("ACTIVE") // ACTIVE | INACTIVE

  volunteer Volunteer @relation(fields: [volunteerId], references: [id])
  ministry  Ministry  @relation(fields: [ministryId], references: [id])

  @@index([volunteerId])
}

/**
 * ─── MINISTRY ─────────────────────────────────
 */
model Ministry {
  id   Int           @id @default(autoincrement())
  name String        @unique
  icon String        @default("Church")
  type MinistryType?

  volunteers   VolunteerMinistryHistory[]
  attendance   VolunteerAttendance[]
  users        User[]
  massBookings MassBooking[]
}

/**
 * ─── VOLUNTEER ATTENDANCE ────────────────────
 */
model VolunteerAttendance {
  id           Int     @id @default(autoincrement())
  volunteerId  Int
  ministryId   Int
  serviceHours Int?
  meetings     Int?
  absences     Int?
  remarks      String?
  attendedAt   Json? // array of dates: ["2025-01-05T08:00:00.000Z", ...]

  volunteer Volunteer @relation(fields: [volunteerId], references: [id])
  ministry  Ministry  @relation(fields: [ministryId], references: [id])
}

/**
 * ─── MASS ────────────────────────────────────
 */
model Mass {
  id       Int      @id @default(autoincrement())
  date     DateTime
  time     String
  language String
  type     String // Holy Mass, Novena, etc.
  category String // SUNDAY | WEDNESDAY | ORDINARY

  slots     Int
  qrOpenAt  DateTime
  createdAt DateTime @default(now())

  bookings MassBooking[]
}

model MassBooking {
  id          Int @id @default(autoincrement())
  massId      Int
  volunteerId Int
  ministryId  Int

  status      AttendanceStatus @default(PENDING)
  servedAt    DateTime? // actual check-in time (QR or manual)
  qrToken     String?          @unique
  confirmedBy Int? // admin user id
  createdAt   DateTime         @default(now())

  mass      Mass      @relation(fields: [massId], references: [id])
  volunteer Volunteer @relation(fields: [volunteerId], references: [id])
  ministry  Ministry  @relation(fields: [ministryId], references: [id])
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model Event {
  id     Int         @id @default(autoincrement())
  title  String
  status EventStatus @default(UPCOMING)

  description String?
  startDate   DateTime
  endDate     DateTime
  startTime   String
  endTime     String

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  volunteers EventVolunteer[]
  attendance EventAttendance[]
}

model EventVolunteer {
  id          Int @id @default(autoincrement())
  eventId     Int
  volunteerId Int

  event     Event     @relation(fields: [eventId], references: [id])
  volunteer Volunteer @relation(fields: [volunteerId], references: [id])
}

model EventAttendance {
  id          Int              @id @default(autoincrement())
  eventId     Int
  volunteerId Int
  status      AttendanceStatus @default(PENDING)

  event     Event     @relation(fields: [eventId], references: [id])
  volunteer Volunteer @relation(fields: [volunteerId], references: [id])
}

model VolunteerFormation {
  id          Int    @id @default(autoincrement())
  volunteerId Int
  name        String
  year        Int

  volunteer Volunteer @relation(fields: [volunteerId], references: [id])

  @@index([volunteerId])
}

model VolunteerTimeline {
  id           Int    @id @default(autoincrement())
  volunteerId  Int
  organization String
  startYear    Int
  endYear      Int?
  totalYears   Int
  type         String // SHRINE | OUTSIDE

  volunteer Volunteer @relation(fields: [volunteerId], references: [id])

  @@index([volunteerId])
}
